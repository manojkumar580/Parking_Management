{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ParkingManagementDb;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Issuer": "ParkingManagementApi",
        "Audience": "ParkingManagementClient",
        "ExpirationMinutes": 60
    },
    "ParkingPricing": {
        "First24HoursRate": 50,
        "After24HoursRate": 75,
        "MonthlySubscriptionRate": 3000
    }
}
